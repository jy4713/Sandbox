# =============================================================================
# AI Secure Sandbox - Developer runtime configuration
# Copy this file to .env and fill only values supplied/approved by the platform
# team. Application/service secrets are fetched from AWS SSM at runtime.
# Exception: AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY may be supplied here only
# when IAM Identity Center (SSO) bootstrap values are unavailable. Protect .env
# as a local secret file and never commit or copy it into an image.
# =============================================================================

# Optional Databricks routing configuration used only by `ucode ...` and the
# Databricks CLI. Bare `claude` and `gemini` commands do not use these values.
DATABRICKS_HOST=
DATABRICKS_CLAUDE_MODEL=
DATABRICKS_GEMINI_MODEL=

# Direct provider API keys are NOT stored here. They are read from SSM:
#   <SSM_PREFIX>/claude-api-key
#   <SSM_PREFIX>/gemini-api-key
# Databricks routing uses <SSM_PREFIX>/databricks-token.
# Managed Databricks SQL MCP uses a separate <SSM_PREFIX>/databricks-sql-mcp-token SecureString.

# AWS region and SSM namespace.
SANDBOX_AWS_PROFILE=sandbox
SSM_PREFIX=/sandbox
AWS_REGION=eu-west-2

# AWS authentication priority:
#   1) If BOTH AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are configured, the
#      Sandbox uses them for STS/SSM (and Production ECR bootstrap). SSO values
#      below are optional and ignored for authentication.
#   2) If neither key is configured, the Sandbox falls back to IAM Identity
#      Center (SSO) and the SSO values below must be configured.
#   3) Supplying only one key is a configuration error; it never silently falls
#      back to SSO. AWS_SESSION_TOKEN is optional for temporary AWS credentials.
#
# SECURITY: .env is a local secret file when static credentials are used.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# AWS IAM Identity Center (SSO) fallback - NON-SECRET.
# These values are required only when the static key pair above is absent.
AWS_SSO_SESSION=sandbox
AWS_SSO_START_URL=https://<company>.awsapps.com/start
AWS_SSO_REGION=<identity-center-region>
AWS_SSO_ACCOUNT_ID=<12-digit-account-id>
AWS_SSO_ROLE_NAME=<sandbox-developer-permission-set-role>

# Developer identity used for audit attribution.
DEVELOPER_ID=yourname

# Require secret-backed application audit events to be writable before execution.
SANDBOX_AUDIT_REQUIRED=true

# Optional AI prompt/response content logging. Default is disabled.
# When true, prompt/response content can contain source code, customer data,
# credentials accidentally pasted by a Developer, and other sensitive data.
# Use only with explicit Security/Data Privacy approval and appropriate host/SIEM
# access controls and retention.
SANDBOX_CONTENT_LOGGING=false

# Optional non-secret service endpoints.
SNYK_API=
HIDDENLAYER_API_URL=


# Host-visible sandbox log root.
# Leave blank for a package-local logs directory.
# Recommended Windows 365 Production value after Admin provisioning:
# SANDBOX_LOG_ROOT=C:/ProgramData/AI-Sandbox/Logs
SANDBOX_LOG_ROOT=

# Production only. Leave blank for POC.
ECR_REGISTRY=

# Production only. Normally leave blank to use:
#   <SSM_PREFIX>/runtime/approved-images-json
APPROVED_IMAGES_SSM_PARAMETER=
