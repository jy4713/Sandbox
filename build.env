# =============================================================================
# AI Secure Sandbox v1.16.14 - build parameters
# Copy to .build.env. Do not commit .build.env.
#
# Admin build sequence:
#   1. Copy this file to .build.env.
#   2. Resolve immutable image digests and downloadable-tool hashes.
#   3. Run scripts/admin/build-sandbox.sh or .ps1 with SandboxType.
#
# Iterative-build optimization (v1.16.14):
#   Copy a previously resolved .build.env into this package, then use
#   -ReuseHardenedBase / --reuse-hardened-base. If every required build value
#   is valid and the exact labelled hardened digest is still available, the
#   hardening stage is skipped. Any missing/invalid value or unavailable/mismatched
#   hardened image automatically falls back to a full resolver + hardening build.
#   PowerShell can also copy the old file with -BuildEnvSource <path>.
#
# SandboxType policy is enforced by the admin wrapper:
#   POC         -> self-hardened Ubuntu 24.04 (OpenSCAP remediation)
#   any non-POC -> Ubuntu Pro + USG hardening
# =============================================================================
SANDBOX_VERSION=v1.16.16
RELEASE_TAG=v1.16.16
DEVCONTAINER_TARGET=baseline

# Digest-pinned base images - REQUIRED. The hardened-base builder updates
# BASE_IMAGE and SQUID_BASE_IMAGE to the SAME hardened image digest.
BASE_IMAGE=localhost:5000/ai-sandbox-hardened-base@sha256:179cbf525605ed1131724844df5ef420adf13b5223d9d1c957d486f392b1c3b0
NODE_IMAGE=node:20-bookworm-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0
SQUID_BASE_IMAGE=localhost:5000/ai-sandbox-hardened-base@sha256:179cbf525605ed1131724844df5ef420adf13b5223d9d1c957d486f392b1c3b0

# =============================================================================
# APPLICATION MAINTENANCE ZONE - BUILD-TIME TOOLS
# Add/remove exact application version variables here. If a variable is required,
# also update scripts/common/load-build-env.sh and Load-BuildEnv.ps1, then pass
# the ARG through both POC build-and-export.* and Production 02-setup-ecr.*.
# =============================================================================
# AI / agent tools - exact versions, no ranges.
CLAUDE_CODE_VERSION=2.1.212
GEMINI_CLI_VERSION=0.53.0
TAVILY_CLI_VERSION=0.1.6
TAVILY_MCP_VERSION=0.2.21
# Local stdio -> remote MCP bridge for Databricks managed SQL MCP.
MCP_REMOTE_VERSION=0.1.38
SNYK_CLI_VERSION=1.1306.2
NPM_REGISTRY=https://registry.npmjs.org

# AWS CLI archive - SHA-256 REQUIRED.
AWSCLI_URL=https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip
AWSCLI_SHA256=96ab904b1fec2b49972685aecc1d2e8c0fd0c981d7a81f5dc5d2dd725ace05f1

# Databricks CLI - exact immutable release + SHA-256 REQUIRED.
DATABRICKS_CLI_VERSION=1.10.0
DATABRICKS_CLI_URL=https://github.com/databricks/cli/releases/download/v1.10.0/databricks_cli_1.10.0_linux_amd64.zip
DATABRICKS_CLI_SHA256=7cde47127a642e60b74a21fc07d5777f0b312cf13aa6a5038220d61af0e7563f

# Databricks ucode - resolver pins current main to an immutable 40-hex commit.
# v1.16.14 also validates that the pinned build supports --profiles/--use-pat/--skip-validate headless PAT configuration.
UCODE_GIT_REF=4ad17f26666df7c6c61870429f216d5be932aa2b

# OpenSCAP / ComplianceAsCode assessment content.
SSG_VERSION=0.1.80
SSG_URL=https://github.com/ComplianceAsCode/content/releases/download/v0.1.80/scap-security-guide-0.1.80.zip
SSG_SHA256=0b5bf56afcac8d7a174ca5f6c37dc9e45cb067d8a45bf68a3458684e93d11b1e
CIS_PROFILE_ID=xccdf_org.ssgproject.content_profile_cis_level1_server

# POC can generate evidence while an approved tailoring set is still being
# developed. Production/ECR scripts FORCE REQUIRE_CIS_PASS=true regardless
# of this value.
REQUIRE_CIS_PASS=false

# Git Credential Manager.
GCM_VERSION=2.5.0
GCM_SHA256=d50ed45408fc76ae82bced4025514987f8c8e9e7c2ab9f4bf57ccbc854d68b3e

# Security gates.
MAX_CRITICAL_FINDINGS=0
MAX_HIGH_FINDINGS=0
REQUIRE_IMAGE_SIGNING=false
COSIGN_KEY_REF=awskms:///alias/ai-sandbox-signing
# -----------------------------------------------------------------------------
# Production approved-image manifest publication
# -----------------------------------------------------------------------------
# The Production build writes immutable ECR digests to approved-images.json.
# By default it also publishes the non-secret manifest to SSM so existing
# Developer runtime packages automatically pick up image-only releases.
PUBLISH_APPROVED_MANIFEST_TO_SSM=true
SSM_PREFIX=/sandbox
APPROVED_IMAGES_SSM_PARAMETER=


# =============================================================================
# DEVELOPER AWS SSO FALLBACK DEFAULTS - NON-SECRET
# Optional Admin distribution defaults. These values are safe to package for
# Developers and can be copied into the Developer .env.example before release.
# Static AWS credentials are runtime-only and must never be placed in .build.env.
# Never place AWS access keys, secret access keys, passwords or SSO tokens here.
# =============================================================================
DEVELOPER_AWS_PROFILE=sandbox
DEVELOPER_AWS_REGION=eu-west-2
DEVELOPER_AWS_SSO_SESSION=sandbox
DEVELOPER_AWS_SSO_START_URL=https://<company>.awsapps.com/start
DEVELOPER_AWS_SSO_REGION=<identity-center-region>
DEVELOPER_AWS_SSO_ACCOUNT_ID=<12-digit-account-id>
DEVELOPER_AWS_SSO_ROLE_NAME=<sandbox-developer-permission-set-role>
